gin-top:3px'&gt;&lt;font color='#607D8B'&gt;読む OmiyageShop の TapPower&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ MochiWallet の Add()&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ StageProgress の AddProgress()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFCDD2;strokeColor=#C62828;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_tap"><mxGeometry x="15" y="58" width="240" height="89" as="geometry"/></mxCell><mxCell id="L_auto" value="AutoIncome.cs&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;付いている物：AutoIncome&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=44;rounded=1;arcSize=4;fontSize=13;fillColor=#CFD8DC;swimlaneFillColor=#FAFAFA;strokeColor=#455A64;" vertex="1" parent="1"><mxGeometry x="350" y="60" width="270" height="191" as="geometry"/></mxCell><mxCell id="auto_up" value="&lt;b&gt;Update()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;毎フレーム、自動で増やす&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#607D8B'&gt;読む OmiyageShop の Mps&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ MochiWallet の Add()&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ StageProgress の AddProgress()&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ MochiFormat の Format()&lt;/font&gt;&lt;br&gt;&lt;font color='#33691E'&gt;画面 MpsText&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFE0B2;strokeColor=#E65100;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_auto"><mxGeometry x="15" y="58" width="240" height="119" as="geometry"/></mxCell><mxCell id="L_start" value="StartScreen.cs&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;付いている物：StartScreen&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=44;rounded=1;arcSize=4;fontSize=13;fillColor=#CFD8DC;swimlaneFillColor=#FAFAFA;strokeColor=#455A64;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="270" height="263" as="geometry"/></mxCell><mxCell id="st_down" value="&lt;b&gt;OnPointerDown(eventData)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;消え始めの合図を出す&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#33691E'&gt;画面 blocksRaycasts を false に&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFCDD2;strokeColor=#C62828;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_start"><mxGeometry x="15" y="58" width="240" height="59" as="geometry"/></mxCell><mxCell id="st_up" value="&lt;b&gt;Update()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;点滅・消える動き&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#33691E'&gt;画面 Hint の alpha（点滅）&lt;/font&gt;&lt;br&gt;&lt;font color='#33691E'&gt;画面 StartScreen の alpha と大きさ&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFE0B2;strokeColor=#E65100;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_start"><mxGeometry x="15" y="175" width="240" height="74" as="geometry"/></mxCell><mxCell id="L_fmt" value="MochiFormat.cs（static）&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;シーンに置かない道具&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=44;rounded=1;arcSize=4;fontSize=13;fillColor=#CFD8DC;swimlaneFillColor=#FAFAFA;strokeColor=#455A64;" vertex="1" parent="1"><mxGeometry x="970" y="60" width="560" height="146" as="geometry"/></mxCell><mxCell id="f_fmt" value="&lt;b&gt;Format(n)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;数 → 表示用の文字&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← MochiWallet・AutoIncome&lt;/font&gt;&lt;br&gt;&lt;font color='#BF360C'&gt;← StageProgress・OmiyageShelf&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_fmt"><mxGeometry x="15" y="58" width="240" height="74" as="geometry"/></mxCell><mxCell id="f_unit" value="&lt;b&gt;WithUnit(n, unit, unitName)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;単位で割って、小数6桁＋単位&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_fmt"><mxGeometry x="305" y="58" width="240" height="44" as="geometry"/></mxCell><mxCell id="L_wallet" value="MochiWallet.cs&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;付いている物：MochiWallet&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=44;rounded=1;arcSize=4;fontSize=13;fillColor=#CFD8DC;swimlaneFillColor=#FAFAFA;strokeColor=#455A64;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="560" height="347" as="geometry"/></mxCell><mxCell id="w_start" value="&lt;b&gt;Start()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;最初の表示&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFE0B2;strokeColor=#E65100;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_wallet"><mxGeometry x="15" y="58" width="240" height="44" as="geometry"/></mxCell><mxCell id="w_add" value="&lt;b&gt;Add(amount)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;もちを amount だけ増やす&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← MochisukeTap・AutoIncome&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_wallet"><mxGeometry x="15" y="120" width="240" height="59" as="geometry"/></mxCell><mxCell id="w_spend" value="&lt;b&gt;TrySpend(amount)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;足りれば払って true&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← OmiyageShop の TryBuy()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_wallet"><mxGeometry x="15" y="197" width="240" height="59" as="geometry"/></mxCell><mxCell id="w_mochi" value="&lt;b&gt;Mochi&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;今のもち数（プロパティ）&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← OmiyageShelf が読む&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ECEFF1;strokeColor=#78909C;dashed=1;fontStyle=2;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_wallet"><mxGeometry x="15" y="274" width="240" height="59" as="geometry"/></mxCell><mxCell id="w_text" value="&lt;b&gt;UpdateText()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;「〇〇 もち」を出す&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#263238'&gt;→ MochiFormat の Format()&lt;/font&gt;&lt;br&gt;&lt;font color='#33691E'&gt;画面 MochiCount&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_wallet"><mxGeometry x="305" y="120" width="240" height="74" as="geometry"/></mxCell><mxCell id="L_prog" value="StageProgress.cs&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;付いている物：StageProgress&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=44;rounded=1;arcSize=4;fontSize=13;fillColor=#CFD8DC;swimlaneFillColor=#FAFAFA;strokeColor=#455A64;" vertex="1" parent="1"><mxGeometry x="640" y="360" width="560" height="295" as="geometry"/></mxCell><mxCell id="p_start" value="&lt;b&gt;Start()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&g