MochisukeTap が読む&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ECEFF1;strokeColor=#78909C;dashed=1;fontStyle=2;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shop"><mxGeometry x="15" y="120" width="240" height="59" as="geometry"/></mxCell><mxCell id="o_mps" value="&lt;b&gt;Mps&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;自動増加効果×レベル&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← AutoIncome が読む&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ECEFF1;strokeColor=#78909C;dashed=1;fontStyle=2;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shop"><mxGeometry x="15" y="197" width="240" height="59" as="geometry"/></mxCell><mxCell id="o_level" value="&lt;b&gt;GetLevel(index)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;今のレベル&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← OmiyageShelf の UpdateDetail()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shop"><mxGeometry x="15" y="274" width="240" height="59" as="geometry"/></mxCell><mxCell id="o_price" value="&lt;b&gt;GetPrice(index)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;次に買う値段&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← OmiyageShelf の UpdateDetail()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shop"><mxGeometry x="15" y="351" width="240" height="59" as="geometry"/></mxCell><mxCell id="o_buy" value="&lt;b&gt;TryBuy(index)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt