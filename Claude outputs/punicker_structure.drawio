try x="15" y="135" width="240" height="89" as="geometry"/></mxCell><mxCell id="sh_buy" value="&lt;b&gt;OnClickBuy()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;購入ボタン&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#263238'&gt;→ OmiyageShop の TryBuy()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E1BEE7;strokeColor=#6A1B9A;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shelf"><mxGeometry x="15" y="262" width="240" height="59" as="geometry"/></mxCell><mxCell id="sh_clicked" value="&lt;b&gt;OnSlotClicked(slotNumber)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;押されたマスのおみやげを選ぶ&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← OmiyageSlot の OnClick()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shelf"><mxGeometry x="15" y="339" width="240" height="59" as="geometry"/></mxCell><mxCell id="sh_next" value="&lt;b&gt;OnClickNextPage()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;＞ ボタン&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E1BEE7;strokeColor=#6A1B9A;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shelf"><mxGeometry x="15" y="436" width="240" height="44" as="geometry"/></mxCell><mxCell id="sh_prev" value="&lt;b&gt;OnClickPrevPage()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;＜ ボタン&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E1BEE7;strokeColor=#6A1B9A;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shelf"><mxGeometry x="15" y="498" width="240" height="44" as="geometry"/></mxCell><mxCell id="sh_slots" value="&lt;b&gt;UpdateSlots()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' col